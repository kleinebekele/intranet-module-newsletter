{
    "name": "do1emu/module-newsletter",
    "description": "Newsletter-Modul für die modulare Intranet-Plattform: Rundmails an ausgewählte Benutzerrollen, gedrosselt über den Ausgangskorb des Core.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "intranet", "modul", "newsletter", "mail"],
    "authors": [
        {
            "name": "do1emu"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Intranet\\Modules\\Newsletter\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Intranet\\Modules\\Newsletter\\NewsletterServiceProvider"
            ]
        }
    }
}
